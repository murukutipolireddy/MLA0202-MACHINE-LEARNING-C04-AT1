import numpy as np


image = np.array([
    [10, 20, 30, 40, 50],
    [15, 200, 35, 45, 55],
    [20, 30, 40, 250, 60],
    [25, 35, 45, 55, 65],
    [30, 40, 50, 60, 70]
])

updated_image = image.copy()

rows, cols = image.shape

for i in range(1, rows - 1):
    for j in range(1, cols - 1):

        top = image[i - 1, j]
        bottom = image[i + 1, j]
        left = image[i, j - 1]
        right = image[i, j + 1]

        average = (top + bottom + left + right) / 4

        updated_image[i, j] = int(average)

print("Original Image:")
print(image)

print("\nUpdated Image:")
print(updated_image)
